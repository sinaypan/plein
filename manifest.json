{
  "manifest_version": 3,
  "name": "Plein",
  "version": "1.0.0",
  "description": "Chrome toujours en plein écran : la souris en haut montre vos onglets, en bas la barre Windows.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "grid.js",
        "edges.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Plein",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "tab-grid": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Voir tous les onglets"
    }
  }
}
